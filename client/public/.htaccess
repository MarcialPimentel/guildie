# Guildie web client caching (copied into public_html/games/guildie/ by the deploy).
# index.html is always re-checked, so a deploy shows up on the next reload.
# Files in assets/ have a content hash in their name, so they can be cached for a long time.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
